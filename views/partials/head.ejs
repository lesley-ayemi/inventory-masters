<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= company.name %>: <%= company.tagline %>. Stock audits, ERP alignment, demand planning and Lean coaching for engineering operations.">
  <meta name="theme-color" content="#1c1b42">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png">
  <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta property="og:image" content="/img/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <script>document.documentElement.classList.add('js')</script>
</head>
<body>
  <header class="site-header" id="top">
    <div class="container nav">
      <a class="brand" href="/">
        <img class="brand-logo" src="/img/logo-144.png" width="44" height="44" alt="">
        <span><%= company.name %></span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="nav-links" class="nav-links" aria-label="Main">
        <a href="/#services">Services</a>
        <a href="/#approach">Approach</a>
        <a href="/#outcomes">Outcomes</a>
        <a href="/#roadmap">Roadmap</a>
        <a href="/#why">Why us</a>
        <a class="btn btn-small" href="/#contact">Get in touch</a>
      </nav>
    </div>
  </header>
